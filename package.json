{
  "name": "edokanban",
  "version": "0.0.1",
  "description": "Embeddable Kanban-board widget: Semantic HTML task cards, JavaScript-generated columns, drag & drop via Pointer Events, card order persisted locally and merged with the source on load.",
  "type": "module",
  "main": "dist/edokanban.esm.js",
  "module": "dist/edokanban.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "build": "node esbuild.config.mjs --minify && tsc --project tsconfig.build.json",
    "watch": "node esbuild.config.mjs --watch",
    "dev": "node esbuild.config.mjs --watch --serve",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [],
  "author": "Benjamin Benno Falkner <bennof@falkner.xyz>",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
